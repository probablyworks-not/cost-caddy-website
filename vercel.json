{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/v5", "destination": "/", "permanent": false },
    { "source": "/v5/:path*", "destination": "/:path*", "permanent": false }
  ]
}
